{
  "cases": [
    {
      "description": "The v1 floor: integrity without authenticity.",
      "expect": "accept",
      "id": "gate-hashonly-accept",
      "manifest": {
        "entry": "plugins/ugpio/acme_relay.py",
        "firmware_compat": ">=1.10.0",
        "model_compat": ">=rm1pe",
        "name": "acme_relay",
        "payload": {
          "sha256": "2251b5b2a6f1b50e5bd3697f76e3721a851f268372c007987f76c264f086ad64",
          "size": 10240
        },
        "revision": 1,
        "runtime": "device",
        "signature": {
          "entries": [],
          "model": "hash-only"
        },
        "type": "ugpio"
      },
      "payload_blob": "reference-bundle.tar",
      "verifier": "hash-only"
    },
    {
      "code": "payload.hash_mismatch",
      "description": "One flipped byte, same length — so this is caught by the hash and not by the size check.",
      "expect": "refuse",
      "id": "gate-hashonly-corrupt-payload",
      "manifest": {
        "entry": "plugins/ugpio/acme_relay.py",
